# =====================================================
# .env.example — Variáveis de ambiente do getvetly
# Copie para .env.local e preencha com suas chaves reais.
# NUNCA commite o .env.local — apenas este .env.example.
# Arquitetura: Postgres self-hosted + Auth.js (ver ADR-007).
# =====================================================

# ---- Banco de dados (PostgreSQL self-hosted no VPS) ----
# App normal (respeita RLS):
DATABASE_URL=postgresql://getvetly_app:SENHA@localhost:5432/getvetly
# Worker/serviço (ignora RLS via BYPASSRLS) — usar só no server:
DATABASE_URL_SERVICE=postgresql://getvetly_service:SENHA@localhost:5432/getvetly

# ---- Auth.js (NextAuth v5) ----
# Gere com: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000
# Em produção (atrás do Nginx), defina como true:
AUTH_TRUST_HOST=true
# Google OAuth (criar em https://console.cloud.google.com → Credentials):
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ---- Anthropic (Claude API) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ---- Mistral OCR ----
MISTRAL_API_KEY=

# ---- Stripe (BR) ----
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MENSAL=
STRIPE_PRICE_STARTER_ANUAL=
STRIPE_PRICE_PRO_MENSAL=
STRIPE_PRICE_PRO_ANUAL=
STRIPE_PRICE_BUSINESS_MENSAL=
STRIPE_PRICE_BUSINESS_ANUAL=

# ---- Resend (e-mail transacional) ----
RESEND_API_KEY=
RESEND_FROM_EMAIL=nao-responda@getvetly.com
RESEND_REPLY_TO=suporte@getvetly.com

# ---- Storage de arquivos ----
# MVP: disco do VPS. Trocar por Cloudflare R2 ao escalar (ver ADR-007).
STORAGE_DIR=/var/www/getvetly/storage

# ---- Inngest (worker assíncrono) ----
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ---- Posthog (analytics) ----
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ---- Sentry (error tracking) ----
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_ENV=development
# Segredo para assinar links compartilháveis /r/[token]:
JWT_SHARED_LINK_SECRET=

# ---- Admin interno ----
INTERNAL_ADMIN_EMAILS=brunobrm@gmail.com
