# O projeto vive em uma pasta do Google Drive (G:\Meu Drive\...), que não
# suporta symlinks. O pnpm usa symlinks por padrão para montar node_modules,
# o que causa erro EISDIR. node-linker=hoisted força um node_modules plano
# (estilo npm), sem symlinks — funciona no Google Drive.
node-linker=hoisted
